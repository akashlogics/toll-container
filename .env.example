# Copy this file to .env, then fill in the two values below.
# Get both from your Supabase project: Settings -> API
#
# VITE_SUPABASE_URL      -> "Project URL"
# VITE_SUPABASE_ANON_KEY -> "anon public" key (NOT the service_role key --
#                            that one must never go in this file or in
#                            any code that ships to the browser)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
